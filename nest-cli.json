{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/gateway/src",
  "compilerOptions": {
    "deleteOutDir": false,
    "builder": "swc"
  },
  "monorepo": true,
  "root": "apps/gateway",
  "projects": {
    "auth": {
      "type": "application",
      "root": "apps/auth",
      "entryFile": "main",
      "sourceRoot": "apps/auth/src",
      "compilerOptions": {
        "builder": "swc",
        "tsConfigPath": "apps/auth/tsconfig.app.json"
      }
    },
    "cached": {
      "type": "library",
      "root": "libs/cached",
      "entryFile": "index",
      "sourceRoot": "libs/cached/src",
      "compilerOptions": {
        "tsConfigPath": "libs/cached/tsconfig.lib.json"
      }
    },
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": {
        "tsConfigPath": "libs/common/tsconfig.lib.json"
      }
    },
    "database": {
      "type": "library",
      "root": "libs/database",
      "entryFile": "index",
      "sourceRoot": "libs/database/src",
      "compilerOptions": {
        "tsConfigPath": "libs/database/tsconfig.lib.json"
      }
    },
    "gateway": {
      "type": "application",
      "root": "apps/gateway",
      "entryFile": "main",
      "sourceRoot": "apps/gateway/src",
      "compilerOptions": {
        "builder": "swc",
        "tsConfigPath": "apps/gateway/tsconfig.app.json"
      }
    },
    "inventory": {
      "type": "application",
      "root": "apps/inventory",
      "entryFile": "main",
      "sourceRoot": "apps/inventory/src",
      "compilerOptions": {
        "builder": "swc",
        "tsConfigPath": "apps/inventory/tsconfig.app.json"
      }
    },
    "orders": {
      "type": "application",
      "root": "apps/orders",
      "entryFile": "main",
      "sourceRoot": "apps/orders/src",
      "compilerOptions": {
        "builder": "swc",
        "tsConfigPath": "apps/orders/tsconfig.app.json"
      }
    },
    "payments": {
      "type": "application",
      "root": "apps/payments",
      "entryFile": "main",
      "sourceRoot": "apps/payments/src",
      "compilerOptions": {
        "builder": "swc",
        "tsConfigPath": "apps/payments/tsconfig.app.json"
      }
    },
    "product": {
      "type": "application",
      "root": "apps/product",
      "entryFile": "main",
      "sourceRoot": "apps/product/src",
      "compilerOptions": {
        "builder": "swc",
        "tsConfigPath": "apps/product/tsconfig.app.json"
      }
    },
    "rewards": {
      "type": "application",
      "root": "apps/rewards",
      "entryFile": "main",
      "sourceRoot": "apps/rewards/src",
      "compilerOptions": {
        "builder": "swc",
        "tsConfigPath": "apps/rewards/tsconfig.app.json"
      }
    },
    "shipments": {
      "type": "application",
      "root": "apps/shipments",
      "entryFile": "main",
      "sourceRoot": "apps/shipments/src",
      "compilerOptions": {
        "builder": "swc",
        "tsConfigPath": "apps/shipments/tsconfig.app.json"
      }
    },
    "user": {
      "type": "application",
      "root": "apps/user",
      "entryFile": "main",
      "sourceRoot": "apps/user/src",
      "compilerOptions": {
        "builder": "swc",
        "tsConfigPath": "apps/user/tsconfig.app.json"
      }
    }
  }
}